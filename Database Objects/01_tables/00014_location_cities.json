{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "00014-location-cities",
        "author": "gescomph-team",
        "context": "develop,qa,staging,main",
        "changes": [
          {
            "createTable": {
              "schemaName": "Location",
              "tableName": "Cities",
              "columns": [
                {
                  "column": {
                    "name": "Id",
                    "type": "INT IDENTITY(1,1)",
                    "constraints": {
                      "primaryKey": true,
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "Active",
                    "type": "BIT",
                    "defaultValueBoolean": true,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "IsDeleted",
                    "type": "BIT",
                    "defaultValueBoolean": false,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "CreatedAt",
                    "type": "DATETIME2",
                    "defaultValueComputed": "SYSUTCDATETIME()",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "Name",
                    "type": "NVARCHAR(100)",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "DepartmentId",
                    "type": "INT",
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableSchemaName": "Location",
              "baseTableName": "Cities",
              "baseColumnNames": "DepartmentId",
              "constraintName": "FK_Cities_Departments",
              "referencedTableSchemaName": "Location",
              "referencedTableName": "Departments",
              "referencedColumnNames": "Id",
              "onDelete": "RESTRICT"
            }
          },
          {
            "addUniqueConstraint": {
              "schemaName": "Location",
              "tableName": "Cities",
              "columnNames": "Name, DepartmentId",
              "constraintName": "UK_Cities_Name_Department"
            }
          },
          {
            "createIndex": {
              "schemaName": "Location",
              "tableName": "Cities",
              "indexName": "IX_Cities_CreatedAt_Id",
              "unique": false,
              "columns": [
                { "column": { "name": "CreatedAt", "descending": true } },
                { "column": { "name": "Id", "descending": true } }
              ]
            }
          }
        ]
      }
    }
  ]
}
