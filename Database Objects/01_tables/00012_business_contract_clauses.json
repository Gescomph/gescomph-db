{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "00012-business-contract_clauses",
        "author": "gescomph-team",
        "context": "develop,qa,staging,main",
        "changes": [
          {
            "createTable": {
              "schemaName": "Business",
              "tableName": "ContractClauses",
              "columns": [
                {
                  "column": {
                    "name": "Id",
                    "type": "INT IDENTITY(1,1)",
                    "constraints": {
                      "primaryKey": true,
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "Active",
                    "type": "BIT",
                    "defaultValueBoolean": true,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "IsDeleted",
                    "type": "BIT",
                    "defaultValueBoolean": false,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "CreatedAt",
                    "type": "DATETIME2",
                    "defaultValueComputed": "SYSUTCDATETIME()",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "ContractId",
                    "type": "INT",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "ClauseId",
                    "type": "INT",
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableSchemaName": "Business",
              "baseTableName": "ContractClauses",
              "baseColumnNames": "ContractId",
              "constraintName": "FK_ContractClauses_Contracts",
              "referencedTableSchemaName": "Business",
              "referencedTableName": "Contracts",
              "referencedColumnNames": "Id",
              "onDelete": "CASCADE"
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableSchemaName": "Business",
              "baseTableName": "ContractClauses",
              "baseColumnNames": "ClauseId",
              "constraintName": "FK_ContractClauses_Clauses",
              "referencedTableSchemaName": "Business",
              "referencedTableName": "Clauses",
              "referencedColumnNames": "Id",
              "onDelete": "RESTRICT"
            }
          },
          {
            "addUniqueConstraint": {
              "schemaName": "Business",
              "tableName": "ContractClauses",
              "columnNames": "ContractId, ClauseId",
              "constraintName": "UK_ContractClauses_Contract_Clause"
            }
          },
          {
            "createIndex": {
              "schemaName": "Business",
              "tableName": "ContractClauses",
              "indexName": "IX_ContractClauses_CreatedAt_Id",
              "unique": false,
              "columns": [
                { "column": { "name": "CreatedAt", "descending": true } },
                { "column": { "name": "Id", "descending": true } }
              ]
            }
          }
        ]
      }
    }
  ]
}
