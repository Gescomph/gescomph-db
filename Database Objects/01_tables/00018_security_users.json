{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "00018-security_users",
        "author": "gescomph-team",
        "context": "develop,qa,staging,main",
        "changes": [
          {
            "createTable": {
              "schemaName": "SecurityAuthentication",
              "tableName": "Users",
              "columns": [
                {
                  "column": {
                    "name": "Id",
                    "type": "INT IDENTITY(1,1)",
                    "constraints": {
                      "primaryKey": true,
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "Active",
                    "type": "BIT",
                    "defaultValueBoolean": true,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "IsDeleted",
                    "type": "BIT",
                    "defaultValueBoolean": false,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "CreatedAt",
                    "type": "DATETIME2",
                    "defaultValueComputed": "SYSUTCDATETIME()",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "Email",
                    "type": "NVARCHAR(150)",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "Password",
                    "type": "NVARCHAR(256)",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "PersonId",
                    "type": "INT",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "TwoFactorEnabled",
                    "type": "BIT",
                    "defaultValueBoolean": false,
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          },
          {
            "addUniqueConstraint": {
              "schemaName": "SecurityAuthentication",
              "tableName": "Users",
              "columnNames": "Email",
              "constraintName": "UK_Users_Email"
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableSchemaName": "SecurityAuthentication",
              "baseTableName": "Users",
              "baseColumnNames": "PersonId",
              "constraintName": "FK_Users_Persons",
              "referencedTableSchemaName": "Persons",
              "referencedTableName": "Persons",
              "referencedColumnNames": "Id",
              "onDelete": "RESTRICT"
            }
          },
          {
            "createIndex": {
              "schemaName": "SecurityAuthentication",
              "tableName": "Users",
              "indexName": "IX_Users_CreatedAt_Id",
              "unique": false,
              "columns": [
                { "column": { "name": "CreatedAt", "descending": true } },
                { "column": { "name": "Id", "descending": true } }
              ]
            }
          }
        ]
      }
    }
  ]
}
