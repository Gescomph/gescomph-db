{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "00026-security-password_reset_codes",
        "author": "gescomph-team",
        "context": "develop,qa,staging,main",
        "changes": [
          {
            "createTable": {
              "schemaName": "SecurityAuthentication",
              "tableName": "PasswordResetCodes",
              "columns": [
                { "column": { "name": "Id", "type": "INT IDENTITY(1,1)", "constraints": { "primaryKey": true, "nullable": false } } },
                { "column": { "name": "Active", "type": "BIT", "defaultValueBoolean": true, "constraints": { "nullable": false } } },
                { "column": { "name": "IsDeleted", "type": "BIT", "defaultValueBoolean": false, "constraints": { "nullable": false } } },
                { "column": { "name": "CreatedAt", "type": "DATETIME2", "defaultValueComputed": "SYSUTCDATETIME()", "constraints": { "nullable": false } } },
                { "column": { "name": "Email", "type": "NVARCHAR(100)", "constraints": { "nullable": false } } },
                { "column": { "name": "Code", "type": "NVARCHAR(10)", "constraints": { "nullable": false } } },
                { "column": { "name": "Expiration", "type": "DATETIME2", "constraints": { "nullable": false } } },
                { "column": { "name": "IsUsed", "type": "BIT", "defaultValueBoolean": false, "constraints": { "nullable": false } } }
              ]
            }
          },
          {
            "createIndex": {
              "schemaName": "SecurityAuthentication",
              "tableName": "PasswordResetCodes",
              "indexName": "IX_PasswordResetCodes_Email_Code",
              "unique": false,
              "columns": [
                { "column": { "name": "Email" } },
                { "column": { "name": "Code" } }
              ]
            }
          },
          {
            "createIndex": {
              "schemaName": "SecurityAuthentication",
              "tableName": "PasswordResetCodes",
              "indexName": "IX_PasswordResetCodes_CreatedAt_Id",
              "unique": false,
              "columns": [
                { "column": { "name": "CreatedAt", "descending": true } },
                { "column": { "name": "Id", "descending": true } }
              ]
            }
          }
        ]
      }
    }
  ]
}
