{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "00017-security_permissions",
        "author": "gescomph-team",
        "context": "develop,qa,staging,main",
        "changes": [
          {
            "createTable": {
              "schemaName": "SecurityAuthentication",
              "tableName": "Permissions",
              "columns": [
                {
                  "column": {
                    "name": "Id",
                    "type": "INT IDENTITY(1,1)",
                    "constraints": {
                      "primaryKey": true,
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "Active",
                    "type": "BIT",
                    "defaultValueBoolean": true,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "IsDeleted",
                    "type": "BIT",
                    "defaultValueBoolean": false,
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "CreatedAt",
                    "type": "DATETIME2",
                    "defaultValueComputed": "SYSUTCDATETIME()",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "Name",
                    "type": "NVARCHAR(100)",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "Description",
                    "type": "NVARCHAR(300)"
                  }
                }
              ]
            }
          },
          {
            "addUniqueConstraint": {
              "schemaName": "SecurityAuthentication",
              "tableName": "Permissions",
              "columnNames": "Name",
              "constraintName": "UK_Permissions_Name"
            }
          },
          {
            "createIndex": {
              "schemaName": "SecurityAuthentication",
              "tableName": "Permissions",
              "indexName": "IX_Permissions_CreatedAt_Id",
              "unique": false,
              "columns": [
                { "column": { "name": "CreatedAt", "descending": true } },
                { "column": { "name": "Id", "descending": true } }
              ]
            }
          }
        ]
      }
    }
  ]
